---
// WorkflowPlaceholder.astro
interface Props {
  steps?: number;
  caption?: string;
}
const { steps = 4, caption = 'Workflow diagram · coming soon' } = Astro.props;
---
<div class="workflow-placeholder">
  <div class="workflow-steps">
    {Array.from({ length: steps }).map((_, i) => (
      <div class="workflow-step" key={i}>
        <div class="step-node">{i + 1}</div>
        {i < steps - 1 && <div class="step-arrow">→</div>}
      </div>
    ))}
  </div>
  <div class="workflow-caption">{caption}</div>
</div>

<style>
.workflow-placeholder {
  background: var(--placeholder-bg);
  border: 1px dashed var(--placeholder-border);
  border-radius: var(--mlami-radius-xl);
  padding: 2.5rem 2rem;
  margin: 1.5rem 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
}
.workflow-steps {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
  justify-content: center;
}
.step-node {
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  border: 1px dashed var(--sl-color-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--sl-color-accent);
  font-weight: 600;
  font-size: 0.875rem;
}
.step-arrow {
  color: var(--sl-color-gray-4);
  font-size: 1.25rem;
}
.workflow-caption {
  font-size: 0.7rem;
  color: var(--placeholder-text);
  font-family: var(--sl-font-mono);
}
</style>
